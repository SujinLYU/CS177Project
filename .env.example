# Optional. Demo mode needs no key and makes no external requests.
OPENAI_API_KEY=
# Set a Responses API model with Structured Outputs support available to your account.
OPENAI_MODEL=gpt-4o-mini
# Desktop meeting transcription (audio is sent only while you record with transcription enabled).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Only needed to call the local AI server from the installed extension.
# Copy the 32-letter extension ID from chrome://extensions after loading extension/.
EXTENSION_ID=
PORT=4173
